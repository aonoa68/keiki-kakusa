{"config":{"lang":["ja"],"separator":"[\\s\\-\u3000\u3001\u3002\uff0c\uff0e]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u666f\u6c17\u30fb\u683c\u5dee\u554f\u984c\u3068\u7d71\u8a08\u60c5\u5831","text":"<p>Business Indices, Disparities and Statistics</p> <p>\u7acb\u6559\u5927\u5b66\u30672022\u301c2025\u5e74\u5ea6\u306b\u62c5\u5f53\u3057\u305f\u6388\u696d\u306e\u8cc7\u6599\u3067\u3059\u3002\u3053\u3053\u306b\u7f6e\u3044\u3066\u3044\u308b\u306e\u306f\u4e3b\u306b 2025\u5e74\u5ea6 \u306e\u7248\u3067\u3059\u3002</p> <p>\u904e\u53bb\u306e\u6388\u696d\u306e\u8a18\u9332\u3067\u3059</p> <p>\u3053\u306e\u6388\u696d\u306f\u73fe\u5728\u306f\u958b\u8b1b\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u6210\u7e3e\u8a55\u4fa1\u3084\u8a66\u9a13\u306b\u95a2\u3059\u308b\u30da\u30fc\u30b8\u3001\u4e00\u90e8\u306e\u56f3\u7248\u306f\u3001\u516c\u958b\u306b\u3042\u305f\u3063\u3066\u7701\u3044\u3066\u3044\u307e\u3059\u3002 \u305d\u308c\u4ee5\u5916\u306f\u5f53\u6642\u306e\u307e\u307e\u3067\u3001\u7d71\u8a08\u30c7\u30fc\u30bf\u3084\u5236\u5ea6\u306e\u8a18\u8ff0\u3001\u63d0\u51fa\u65b9\u6cd5\u306e\u6848\u5185\u306a\u3069\u306f\u4f5c\u6210\u6642\u70b9\u306e\u3082\u306e\u3067\u3059\u3002</p>"},{"location":"#_2","title":"\u3053\u306e\u6388\u696d\u306b\u3064\u3044\u3066","text":"<p>\u300c\u666f\u6c17\u300d\u3084\u300c\u683c\u5dee\u300d\u3068\u3044\u3046\u8a00\u8449\u304c\u6307\u3059\u5185\u5bb9\u3092\u3001\u516c\u7684\u7d71\u8a08\u3092\u4f7f\u3063\u3066\u5b9f\u614b\u3068\u3057\u3066\u3068\u3089\u3048\u308b\u65b9\u6cd5\u3092\u5b66\u3076\u6388\u696d\u3067\u3059\uff08\u30b5\u30d6\u30bf\u30a4\u30c8\u30eb\u306f\u300c\u7d4c\u6e08\u7d71\u8a08\u5165\u95801\u300d\uff09\u3002\u4eba\u53e3\u30fb\u52b4\u50cd\u30fb\u8cc3\u91d1\u30fb\u6d88\u8cbb\u306e\u5404\u30c6\u30fc\u30de\u306b\u3064\u3044\u3066\u3001e-Stat \u306a\u3069\u304b\u3089\u653f\u5e9c\u7d71\u8a08\u3092\u5165\u624b\u3057\u3001\u30b0\u30e9\u30d5\u3084\u6307\u6a19\u3092\u81ea\u5206\u3067\u4f5c\u3063\u3066\u8aad\u307f\u89e3\u304d\u307e\u3059\u3002\u6f14\u7fd2\u3067\u306f Google Colaboratory\uff08Python\uff09\u3068 Excel \u3092\u4f7f\u3044\u3001\u79fb\u52d5\u5e73\u5747\u3001\u5f93\u5c5e\u4eba\u53e3\u6307\u6570\u3001\u30d2\u30b9\u30c8\u30b0\u30e9\u30e0\u3001\u30ed\u30fc\u30ec\u30f3\u30c4\u66f2\u7dda\u3068\u30b8\u30cb\u4fc2\u6570\u306a\u3069\u3092\u5b9f\u969b\u306b\u8a08\u7b97\u3057\u307e\u3059\u3002</p> \u5927\u5b66 \u7acb\u6559\u5927\u5b66 \u958b\u8b1b \u5168\u5b66\u5171\u901a\u79d1\u76ee\u30fb\u5168\u5b66\u5171\u901a\u30ab\u30ea\u30ad\u30e5\u30e9\u30e0\uff08\u7dcf\u5408\u7cfb\uff09\uff0f\u591a\u5f69\u306a\u5b66\u3073 \uff0f \u79cb\u5b66\u671f \u62c5\u5f53\u5e74\u5ea6 2022\u301c2025\u5e74\u5ea6 \u4f7f\u7528\u30c4\u30fc\u30eb Python\uff08Google Colab\uff09\u3001Excel\u3001e-Stat\u3001jSTAT MAP\u3001RESAS\uff0fRAIDA\u3001\u751f\u6210AI\uff08ChatGPT \u306a\u3069\uff09 <p>\u516814\u56de\u306e\u3046\u3061\u7b2c1\u30fb5\u30fb7\u30fb9\u30fb11\u30fb13\u30fb14\u56de\u304c\u6559\u5ba4\u3067\u306e\u5bfe\u9762\u56de\u3001\u7b2c2\u30fb3\u30fb4\u30fb6\u30fb8\u30fb10\u30fb12\u56de\u306f\u30aa\u30f3\u30c7\u30de\u30f3\u30c9\u52d5\u753b\u306b\u3088\u308b\u81ea\u7fd2\u56de\u3067\u3057\u305f\u3002\u52d5\u753b\u56de\u306e\u6559\u6750\u306f\u4ed6\u306e\u6559\u54e1\u304c\u4f5c\u6210\u3057\u305f\u3082\u306e\u306e\u305f\u3081\u3001\u3053\u306e\u30b5\u30a4\u30c8\u306b\u306f\u5bfe\u9762\u56de\uff08\u30ac\u30a4\u30c0\u30f3\u30b9\u30fb\u6f14\u7fd2\u30fb\u307e\u3068\u3081\uff09\u306e\u8cc7\u6599\u3060\u3051\u3092\u63b2\u8f09\u3057\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"#_3","title":"\u5404\u56de\u306e\u8cc7\u6599","text":"\u56de \u30c6\u30fc\u30de \u8cc7\u6599 \u7b2c1\u56de \u30ac\u30a4\u30c0\u30f3\u30b9 \u30b9\u30e9\u30a4\u30c9 \u7b2c2\u56de \u7d71\u8a08\u6cd5 \u30aa\u30f3\u30c7\u30de\u30f3\u30c9\u52d5\u753b\u306b\u3088\u308b\u81ea\u7fd2\u56de\u3067\u3059\u3002\u52d5\u753b\u3068\u305d\u306e\u30b9\u30e9\u30a4\u30c9\u306f\u4ed6\u306e\u6559\u54e1\u304c\u4f5c\u6210\u3057\u305f\u6559\u6750\u306e\u305f\u3081\u3001\u3053\u306e\u30b5\u30a4\u30c8\u306b\u306f\u63b2\u8f09\u3057\u3066\u3044\u307e\u305b\u3093\u3002 \u7b2c3\u56de \u516c\u7684\u7d71\u8a08\u306e\u4ed5\u7d44\u307f \u30aa\u30f3\u30c7\u30de\u30f3\u30c9\u52d5\u753b\u306b\u3088\u308b\u81ea\u7fd2\u56de\u3067\u3059\u3002\u52d5\u753b\u3068\u305d\u306e\u30b9\u30e9\u30a4\u30c9\u306f\u4ed6\u306e\u6559\u54e1\u304c\u4f5c\u6210\u3057\u305f\u6559\u6750\u306e\u305f\u3081\u3001\u3053\u306e\u30b5\u30a4\u30c8\u306b\u306f\u63b2\u8f09\u3057\u3066\u3044\u307e\u305b\u3093\u3002 \u7b2c4\u56de \u6307\u6570\u8a08\u7b97 \u30aa\u30f3\u30c7\u30de\u30f3\u30c9\u52d5\u753b\u306b\u3088\u308b\u81ea\u7fd2\u56de\u3067\u3059\u3002\u52d5\u753b\u3068\u305d\u306e\u30b9\u30e9\u30a4\u30c9\u306f\u4ed6\u306e\u6559\u54e1\u304c\u4f5c\u6210\u3057\u305f\u6559\u6750\u306e\u305f\u3081\u3001\u3053\u306e\u30b5\u30a4\u30c8\u306b\u306f\u63b2\u8f09\u3057\u3066\u3044\u307e\u305b\u3093\u3002 \u7b2c5\u56de \u30c7\u30fc\u30bf\u3078\u306e\u30a2\u30af\u30bb\u30b9\u6f14\u7fd2 \u30b9\u30e9\u30a4\u30c9\u30fb\u30c7\u30fc\u30bf \u7b2c6\u56de \u4eba\u53e3\u7d71\u8a08 \u30aa\u30f3\u30c7\u30de\u30f3\u30c9\u52d5\u753b\u306b\u3088\u308b\u81ea\u7fd2\u56de\u3067\u3059\u3002\u52d5\u753b\u3068\u305d\u306e\u30b9\u30e9\u30a4\u30c9\u306f\u4ed6\u306e\u6559\u54e1\u304c\u4f5c\u6210\u3057\u305f\u6559\u6750\u306e\u305f\u3081\u3001\u3053\u306e\u30b5\u30a4\u30c8\u306b\u306f\u63b2\u8f09\u3057\u3066\u3044\u307e\u305b\u3093\u3002 \u7b2c7\u56de \u4eba\u53e3\u7d71\u8a08\u6f14\u7fd2 \u30b9\u30e9\u30a4\u30c9\u30fb\u30c7\u30fc\u30bf \u7b2c8\u56de \u52b4\u50cd\u7d71\u8a08 \u30aa\u30f3\u30c7\u30de\u30f3\u30c9\u52d5\u753b\u306b\u3088\u308b\u81ea\u7fd2\u56de\u3067\u3059\u3002\u52d5\u753b\u3068\u305d\u306e\u30b9\u30e9\u30a4\u30c9\u306f\u4ed6\u306e\u6559\u54e1\u304c\u4f5c\u6210\u3057\u305f\u6559\u6750\u306e\u305f\u3081\u3001\u3053\u306e\u30b5\u30a4\u30c8\u306b\u306f\u63b2\u8f09\u3057\u3066\u3044\u307e\u305b\u3093\u3002 \u7b2c9\u56de \u52b4\u50cd\u7d71\u8a08\u6f14\u7fd2 \u30b9\u30e9\u30a4\u30c9 \u7b2c10\u56de \u8cc3\u91d1\u7d71\u8a08 \u30aa\u30f3\u30c7\u30de\u30f3\u30c9\u52d5\u753b\u306b\u3088\u308b\u81ea\u7fd2\u56de\u3067\u3059\u3002\u52d5\u753b\u3068\u305d\u306e\u30b9\u30e9\u30a4\u30c9\u306f\u4ed6\u306e\u6559\u54e1\u304c\u4f5c\u6210\u3057\u305f\u6559\u6750\u306e\u305f\u3081\u3001\u3053\u306e\u30b5\u30a4\u30c8\u306b\u306f\u63b2\u8f09\u3057\u3066\u3044\u307e\u305b\u3093\u3002 \u7b2c11\u56de \u8cc3\u91d1\u7d71\u8a08\u6f14\u7fd2 \u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599\u30fb\u30c7\u30fc\u30bf \u7b2c12\u56de \u6d88\u8cbb\u7d71\u8a08 \u30aa\u30f3\u30c7\u30de\u30f3\u30c9\u52d5\u753b\u306b\u3088\u308b\u81ea\u7fd2\u56de\u3067\u3059\u3002\u52d5\u753b\u3068\u305d\u306e\u30b9\u30e9\u30a4\u30c9\u306f\u4ed6\u306e\u6559\u54e1\u304c\u4f5c\u6210\u3057\u305f\u6559\u6750\u306e\u305f\u3081\u3001\u3053\u306e\u30b5\u30a4\u30c8\u306b\u306f\u63b2\u8f09\u3057\u3066\u3044\u307e\u305b\u3093\u3002 \u7b2c13\u56de \u6d88\u8cbb\u7d71\u8a08\u6f14\u7fd2 \u30b9\u30e9\u30a4\u30c9\u30fb\u914d\u5e03\u8cc7\u6599\u30fb\u30ce\u30fc\u30c8\u30d6\u30c3\u30af\u30fb\u30c7\u30fc\u30bf\u30fb\u89e3\u7b54\u4f8b \u7b2c14\u56de \u307e\u3068\u3081 \u30b9\u30e9\u30a4\u30c9 <p>\u8cc7\u6599\u306e\u8457\u4f5c\u6a29\u306f\u4f5c\u6210\u8005\uff08\u5c0f\u91ce\u539f \u5f69\u9999\uff09\u306b\u3042\u308a\u307e\u3059\u3002\u8cc7\u6599\u4e2d\u306b\u5f15\u7528\u3057\u305f\u56f3\u8868\u30fb\u7d71\u8a08\u306e\u6a29\u5229\u306f\u3001\u305d\u308c\u305e\u308c\u306e\u51fa\u5178\u5143\u306b\u5e30\u5c5e\u3057\u307e\u3059\u3002\u73fe\u5728\u306e\u62c5\u5f53\u6388\u696d\u306f Teaching \u30da\u30fc\u30b8 \u306b\u307e\u3068\u3081\u3066\u3044\u307e\u3059\u3002</p>"},{"location":"week01/","title":"\u7b2c1\u56de\u3000\u30ac\u30a4\u30c0\u30f3\u30b9","text":"<p>\u6388\u696d\u306e\u9032\u3081\u65b9\uff08\u5bfe\u9762\u306e\u6f14\u7fd2\u56de\u3068\u30aa\u30f3\u30c7\u30de\u30f3\u30c9\u52d5\u753b\u56de\u306e\u7d44\u307f\u5408\u308f\u305b\uff09\u3092\u8aac\u660e\u3057\u307e\u3059\u3002\u3042\u308f\u305b\u3066\u3001\u7d71\u8a08\u3068\u3044\u3046\u8a00\u8449\u306e\u7531\u6765\u3084\u65e5\u672c\u306e\u7d71\u8a08\u6a5f\u69cb\u3001e-Stat\u30fbRESAS\u306a\u3069\u516c\u7684\u7d71\u8a08\u3078\u306e\u30a2\u30af\u30bb\u30b9\u624b\u6bb5\u3001ChatGPT\u3068Google Colaboratory\u3092\u4f7f\u3063\u305f\u30b3\u30fc\u30c9\u4f5c\u6210\u306e\u57fa\u672c\u3092\u7d39\u4ecb\u3057\u307e\u3059\u3002</p>"},{"location":"week01/#_1","title":"\u8cc7\u6599","text":"<ul> <li> \u30b9\u30e9\u30a4\u30c9\uff08\u7d71\u8a08\u306e\u59cb\u307e\u308a\u3068\u65e5\u672c\u306e\u7d71\u8a08\uff09 \uff0834\u30da\u30fc\u30b8\u30fb6.9 MB\u30fb2023\u5e74\u5ea6\u7248\uff09</li> <li> \u30b9\u30e9\u30a4\u30c9\uff08ChatGPT\u3068\u30b3\u30fc\u30c9\u751f\u6210\uff09 \uff087\u30da\u30fc\u30b8\u30fb1.4 MB\u30fb2024\u5e74\u5ea6\u7248\u30fb\u4e00\u90e8\u30da\u30fc\u30b8\u7701\u7565\uff09</li> </ul> <p>\u300c\u4e00\u90e8\u30da\u30fc\u30b8\u7701\u7565\u300d\u3068\u3042\u308b\u8cc7\u6599\u306f\u3001\u516c\u958b\u306b\u3042\u305f\u3063\u3066\u6388\u696d\u904b\u55b6\u306e\u9023\u7d61\u3084\u4e00\u90e8\u306e\u56f3\u7248\u306e\u30da\u30fc\u30b8\u3092\u7701\u3044\u3066\u3044\u307e\u3059\u3002\u305d\u306e\u305f\u3081\u30da\u30fc\u30b8\u756a\u53f7\u304c\u6388\u696d\u6642\u306e\u3082\u306e\u3068\u5408\u308f\u306a\u3044\u7b87\u6240\u304c\u3042\u308a\u307e\u3059\u3002</p>"},{"location":"week01/#_2","title":"\u30b9\u30e9\u30a4\u30c9\u3092\u3053\u306e\u30da\u30fc\u30b8\u3067\u898b\u308b","text":"<p>\u8868\u793a\u3055\u308c\u306a\u3044\u5834\u5408\u306f\u3001\u4e0a\u306e\u300c\u8cc7\u6599\u300d\u306e\u30ea\u30f3\u30af\u304b\u3089 PDF \u3092\u958b\u3044\u3066\u304f\u3060\u3055\u3044\u3002</p>"},{"location":"week05/","title":"\u7b2c5\u56de\u3000\u30c7\u30fc\u30bf\u3078\u306e\u30a2\u30af\u30bb\u30b9\u6f14\u7fd2","text":"<p>\u653f\u5e9c\u7d71\u8a08\u306e\u7dcf\u5408\u7a93\u53e3 e-Stat\u3001\u7d71\u8a08GIS\uff08jSTAT MAP\uff09\u3001RESAS\u30fbRAIDA \u306e\u4f7f\u3044\u65b9\u3092\u78ba\u8a8d\u3057\u3001jSTAT MAP \u3067\u7d